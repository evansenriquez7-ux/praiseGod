  "findings": {
    "competency_fulfillment": {
      "verdict": "CONCERN",
      "rationale": "The competency asks for 'the next term/s', and the plural is deliberate - continuing a pattern by two or more terms is a distinct demand. Every sampled item stops at a single term, so half of what the wording asks for is never tested."
    },
    "comprehensive_coverage": {
      "verdict": "FAIL",
      "rationale": "Of the four media the competency lists, only numbers and letters are generated. Nothing addresses 'rhythmic properties' and nothing addresses 'visual elements in arts'; the picture-led items that could have carried the arts case resolve to numeric option lists instead."
    },
    "cognitive_capacity": {
      "verdict": "PASS",
      "rationale": "Sequences are six terms long, the letter runs follow straightforward alphabet order or a short repeating cycle, and the numbers stay in the twenties and eighties - all well inside what a Grade 2 pupil can hold and continue."
    },
    "variant_comprehensiveness": {
      "verdict": "CONCERN",
      "rationale": "Two presentations exist - an inline listed sequence and an unshown image asking 'What is the missing piece (position 6) in the pattern?' - but there is no growing shape pattern, no object or colour repetition, and no pattern given as a rule to extend."
    },
    "competency_alignment": {
      "verdict": "CONCERN",
      "rationale": "Both fully-displayed number sequences step by exactly one, up in one case and down in the other, so the rule itself never gets harder; what varies is only which medium carries it, which is an axis beside the point of determining a next term."
    },
    "scale_appropriateness": {
      "verdict": "PASS",
      "rationale": "Terms stay in the low twenties and low eighties, which is appropriate for Grade 2 pattern work where the arithmetic must not compete with the pattern recognition."
    }
  },
