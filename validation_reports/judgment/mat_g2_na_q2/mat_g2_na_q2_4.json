  "findings": {
    "competency_fulfillment": {
      "verdict": "PASS",
      "rationale": "Regrouping is required in every single computation sampled, which is what this node demands and what makes it distinct from its neighbours. Both named shapes appear: 2-digit minus 1-digit in seed 45 and 2-digit minus 2-digit in seed 502's 93 take away 65."
    },
    "comprehensive_coverage": {
      "verdict": "CONCERN",
      "rationale": "The minuend is a multiple of ten in roughly two thirds of the pool (30, 20, 60, 90, 50, 80 recur), so the borrowing a child practises is overwhelmingly the special case of a zero in the ones place. General borrowing such as 93 take away 65 or 92 take away 55 is the minority, when it should be the backbone."
    },
    "cognitive_capacity": {
      "verdict": "PASS",
      "rationale": "Bare computation stems are one line, and the worded ones (the part-whole phrasing in seeds 50 and 605, the baskets on the table in seed 601) use concrete nouns and no clause nesting. This suits Quarter 2 of Grade 2."
    },
    "variant_comprehensiveness": {
      "verdict": "PASS",
      "rationale": "Presentation genuinely varies: a horizontal equation with a blank, a 'What is' question, a part-and-whole statement, a dot moving backward on a line, a true-or-false claim, a peer's wrong answer to judge, and a pictured group of 92 drinks. Seven distinct surfaces is ample here."
    },
    "competency_alignment": {
      "verdict": "PASS",
      "rationale": "What changes between easy and hard seeds is the size of the borrow and the distance between the two numbers, not some unrelated dimension. Seed 43's 20 take away 1 and seed 502's 93 take away 65 are the same skill at two intensities."
    },
    "scale_appropriateness": {
      "verdict": "CONCERN",
      "rationale": "Operands obey the under-100 bound, but option lists do not: 158 is offered as a difference for 93 take away 65, 106 for 60 take away 46, and 111 for 60 take away 51. Those are sums wearing a difference's clothes, and they exceed the very ceiling this competency sets."
    }
