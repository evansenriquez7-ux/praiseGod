  "findings": {
    "competency_fulfillment": {
      "verdict": "PASS",
      "rationale": "I worked through all sixteen subtractions and every single one genuinely requires regrouping - the ones digit of the minuend is always smaller than that of the subtrahend. That is the discriminating property this competency names, and nothing in the sample set violates it."
    },
    "comprehensive_coverage": {
      "verdict": "PASS",
      "rationale": "Both digit patterns the competency itemises appear: takes of 3, 1 and 2 from a multiple of ten give the two-digit-minus-one-digit case, while pairs such as 92 less 55 and 93 less 65 give the two-digit-minus-two-digit case."
    },
    "cognitive_capacity": {
      "verdict": "CONCERN",
      "rationale": "A number-line sample tells the pupil to 'just count back 78 numbers' from 80. Counting back seventy-eight single steps is unusable in practice and actively steers the child away from the regrouping strategy this very node exists to build."
    },
    "variant_comprehensiveness": {
      "verdict": "PASS",
      "rationale": "Bare horizontal equations, a part-and-whole phrasing, a pictured large group, an emoji row of books, a story about baskets and a peer-error check all appear, so the node is not resting on one presentation."
    },
    "competency_alignment": {
      "verdict": "PASS",
      "rationale": "Difficulty moves by pushing the subtrahend closer to the minuend, which is what makes a regrouped take harder, and the answers I verified - 92 less 55 giving 37, 93 less 65 giving 28 - are all correct."
    },
    "scale_appropriateness": {
      "verdict": "PASS",
      "rationale": "Both operands stay under 100 in every sample, with the largest minuend at 93, matching the competency's explicit under-100 bound without ever brushing three digits."
    }
  },
  "overall": "CONCERN"
}
