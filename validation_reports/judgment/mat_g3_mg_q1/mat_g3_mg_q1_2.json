  "findings": {
    "competency_fulfillment": {
      "verdict": "PASS",
      "rationale": "Every sample asks for an area and every key is the correct product of the given sides, with the requested unit stated explicitly in the stem so the pupil must answer in square units rather than linear ones."
    },
    "comprehensive_coverage": {
      "verdict": "PASS",
      "rationale": "All four combinations the competency's wording implies are generated: square in sq cm, square in sq m, rectangle in sq cm, rectangle in sq m. Neither shape is confined to one unit."
    },
    "cognitive_capacity": {
      "verdict": "PASS",
      "rationale": "Side lengths stay between two and eight, so every area is a single multiplication fact, and the vocabulary used is limited to side, length, width and area, all introduced by Grade 3 Quarter 1."
    },
    "variant_comprehensiveness": {
      "verdict": "PASS",
      "rationale": "The stem phrasing genuinely rotates rather than resetting numbers in one frame: sides given as a pair, a side described as on each side, length and width named separately, and an imperative to calculate. A chalkboard gives one applied setting, and both multiple choice and cloze occur."
    },
    "competency_alignment": {
      "verdict": "PASS",
      "rationale": "The distractors are built from the competency's own confusions rather than from noise: the sum of the two sides and the perimeter both appear as wrong options against the area key, so choosing correctly requires distinguishing area from the operations it is confused with."
    },
    "scale_appropriateness": {
      "verdict": "PASS",
      "rationale": "The competency states no ceiling; areas range from 6 to 40 square units, which keeps the products inside Grade 3 Quarter 1 multiplication while still spanning a real range of shape sizes."
    }
  },
  "overall": "PASS"
}
