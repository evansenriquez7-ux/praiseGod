  "findings": {
    "competency_fulfillment": {
      "verdict": "CONCERN",
      "rationale": "The competency asks for recognition using models, but the models are almost entirely absent. A flashlight beam analogy and one typed figure showing an endpoint labelled A with an arrowhead past B are all that stand in for a model; the remaining twelve items are definition recall such as naming an exact location in space with no length or width."
    },
    "comprehensive_coverage": {
      "verdict": "CONCERN",
      "rationale": "All four figures are named somewhere, but only the ray is ever offered as something to look at and identify. No sample presents a model of a point, a line or a line segment for the pupil to recognise, so three quarters of the competency's objects are tested only verbally."
    },
    "cognitive_capacity": {
      "verdict": "PASS",
      "rationale": "The endpoint counting, the arrowhead convention and the ruler instruction to start at the 0 cm mark are all standard Grade 3 Quarter 1 geometry language, and no item requires notation or symbolism beyond the naming of the four figures."
    },
    "variant_comprehensiveness": {
      "verdict": "CONCERN",
      "rationale": "Three stems recur word for word within the fourteen samples, the flashlight item, the exact-location item and the 4 cm ruler item each appearing twice, and every sample is multiple choice. Roughly a fifth of the set is literal duplication."
    },
    "competency_alignment": {
      "verdict": "PASS",
      "rationale": "The set does contrast the four figures on the property that actually separates them, how many endpoints each has and in how many directions it continues, so the variation targets the distinction the competency is built on."
    },
    "scale_appropriateness": {
      "verdict": "PASS",
      "rationale": "The only numbers involved are endpoint counts of 0, 1 and 2 and ruler marks up to 10 cm, all of which sit correctly within the measuring range a Grade 3 pupil works in."
    }
  },
  "overall": "CONCERN"
