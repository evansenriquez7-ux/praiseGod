  "findings": {
    "competency_fulfillment": {
      "verdict": "FAIL",
      "rationale": "Describing is served, but representing is entirely absent. Across all fourteen samples there is no item in which the pupil draws, shades, assembles or selects a picture of a circle, half circle or quarter circle -- every response is choosing a shape name or a number from four written options. One of the competency's two verbs has no generated task at all."
    },
    "comprehensive_coverage": {
      "verdict": "CONCERN",
      "rationale": "All three named figures are described, but the part-to-whole composition question exists only for quarters ('How many quarter-circles make 1 whole circle?'), with no matching item for half circles, and no sample combines the pieces back into a whole shape."
    },
    "cognitive_capacity": {
      "verdict": "PASS",
      "rationale": "Vocabulary is limited to the shape names plus corners and straight edges, the partitions used are only 2 and 4, and each question resolves in one judgement -- suitable for the opening quarter of Grade 2."
    },
    "variant_comprehensiveness": {
      "verdict": "CONCERN",
      "rationale": "The effective pool is much smaller than fourteen: 'What shape has no corners and no straight sides?' is reproduced identically at three seeds, and the circle-divided-into-2-equal-parts item at three more, so over a third of the samples are duplicates with only the option order changed."
    },
    "competency_alignment": {
      "verdict": "PASS",
      "rationale": "Where the items do differ, they deepen the same descriptive skill in the right way -- counting straight edges of a half against a quarter, and holding identity under rotation when a quarter-circle is turned to face another direction."
    },
    "scale_appropriateness": {
      "verdict": "PASS",
      "rationale": "The only numbers appearing are the partition counts 2 and 4 and small edge and corner counts, which is the correct numeric register for a shape-description competency at this level."
    }
  },
  "overall": "FAIL"
}
