  "findings": {
    "competency_fulfillment": {
      "verdict": "FAIL",
      "rationale": "The descriptions are impossible as models. A stem stating that a shape is divided into 3 equal parts with 5 parts shaded asks a pupil to picture more shaded parts than the shape contains; a fraction greater than one needs more than one whole, and none of these items ever supplies a second shape. The wording of the competency is about representing such fractions with models, and no coherent model is described here."
    },
    "comprehensive_coverage": {
      "verdict": "PASS",
      "rationale": "Both cases the wording distinguishes are generated and keyed, fractions equal to one such as the eight-eighths and six-sixths items, and fractions greater than one across a range of denominators from halves to eighths."
    },
    "cognitive_capacity": {
      "verdict": "CONCERN",
      "rationale": "Beyond the impossibility, some samples push past two whole units, as where a shape is divided into 8 equal parts and 18 parts are shaded. Holding more than two wholes in an unillustrated description is heavier than a first encounter with improper fractions should be."
    },
    "variant_comprehensiveness": {
      "verdict": "CONCERN",
      "rationale": "Only two phrasings occur, one stating the shading inside the sentence and one splitting it into a second sentence, and neither is accompanied by a drawn region or a sharing situation such as pizzas or cakes that would make a fraction above one meaningful."
    },
    "competency_alignment": {
      "verdict": "PASS",
      "rationale": "What varies across samples is the denominator and how far the numerator exceeds it, including the exactly-equal case, which is the right dimension for an objective about fractions at and above one."
    },
    "scale_appropriateness": {
      "verdict": "PASS",
      "rationale": "Denominators stay between two and eight, which is the range of unit fractions a Grade 3 pupil has met, and no sample asks for simplification or conversion beyond naming the fraction."
    }
  },
  "overall": "FAIL"
}
