  "findings": {
    "competency_fulfillment": {
      "verdict": "PASS",
      "rationale": "Items genuinely hinge on recovering an unknown from a number sentence rather than on plain computation, and the divisors and factors involved are the six, seven, eight and nine the competency specifies."
    },
    "comprehensive_coverage": {
      "verdict": "CONCERN",
      "rationale": "Three of the four possible blank positions appear, the dividend in '___ ÷ 9 = 7', the quotient in '72 ÷ 8 = ___', and a factor in '9 × ___ = 63', but the missing-divisor case is never generated anywhere in the set. Multiplication is also badly outweighed by division, leaving that half of the 'multiplication or division' wording thinly sampled."
    },
    "cognitive_capacity": {
      "verdict": "PASS",
      "rationale": "Inverse reasoning on single-digit facts is a reasonable Quarter 4 demand, and the verbal phrasing 'What divided by 8 equals 9?' gives pupils a spoken route into the same structure the symbolic blanks present."
    },
    "variant_comprehensiveness": {
      "verdict": "PASS",
      "rationale": "The unknown is presented symbolically, verbally, as a balance in 'Both sides balance evenly. 6 × ? = 60.', as a truth judgement, and as another pupil's wrong value to correct. That is more presentational range than a missing-number node usually gets."
    },
    "competency_alignment": {
      "verdict": "PASS",
      "rationale": "What varies across seeds is which element of the sentence is hidden and how far the inverse step reaches, which is precisely the competency's target rather than a proxy such as bigger numbers."
    },
    "scale_appropriateness": {
      "verdict": "PASS",
      "rationale": "Unknowns resolve to values such as 21, 40, 56, 63 and 81, all products of the named tables, and no operand exceeds what those tables generate."
    }
  },
  "overall": "CONCERN"
}
