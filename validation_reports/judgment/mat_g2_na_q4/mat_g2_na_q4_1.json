    "competency_fulfillment": {
      "verdict": "PASS",
      "rationale": "Both directions the competency pairs are generated - turning a spoken word name into notation, and turning printed notation back into words - and every key matches its stem, including the eighth written as a numerator over a denominator."
    },
    "comprehensive_coverage": {
      "verdict": "CONCERN",
      "rationale": "The reading direction is carried almost entirely by one fraction: halves account for most of the word-name items and thirds for one, while fifths and sixths never appear in either direction anywhere in this node."
    },
    "cognitive_capacity": {
      "verdict": "PASS",
      "rationale": "Word names are the ordinary ones a Grade 2 pupil hears, the notation is displayed in stacked form as well as with a slash, and each stem asks for exactly one conversion."
    },
    "variant_comprehensiveness": {
      "verdict": "CONCERN",
      "rationale": "Three separate seeds emit the same 'Which is the correct word name?' stem for the same halved fraction with the same four options merely reordered, which collapses much of the reading strand into one repeated question."
    },
    "competency_alignment": {
      "verdict": "CONCERN",
      "rationale": "The distractor '2 oneths' is not a word form any learner would produce, so items carrying it can be answered by discarding nonsense rather than by reading the fraction, which sidesteps the skill the node exists to build."
    },
    "scale_appropriateness": {
      "verdict": "PASS",
      "rationale": "All fractions sampled keep a numerator of one with denominators no larger than eight, consistent with the unit-fraction scope of this quarter."
    }
