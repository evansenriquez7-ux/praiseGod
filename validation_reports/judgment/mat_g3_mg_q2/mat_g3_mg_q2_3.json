  "findings": {
    "competency_fulfillment": {
      "verdict": "FAIL",
      "rationale": "What is the capacity of the container in mL? names no container, describes no graduation, and reports no reading. Four numeric choices follow a question that contains no evidence at all, so the measurement the competency calls for is never performed and the item cannot be answered on its merits."
    },
    "comprehensive_coverage": {
      "verdict": "FAIL",
      "rationale": "The competency's clause about appropriate measuring tools yields nothing. Across nine samples no graduated cylinder, measuring cup, pitcher or bottle is named, shown or chosen between."
    },
    "cognitive_capacity": {
      "verdict": "CONCERN",
      "rationale": "A capacity of 285 L has no referent a Grade 3 pupil could hold in mind, and distinguishing 2893 mL from 2892 mL is a reading precision no classroom vessel provides."
    },
    "variant_comprehensiveness": {
      "verdict": "FAIL",
      "rationale": "The generator emits a single interrogative shape nine times over; whether the unit reads L or mL is the whole of the variation. Nothing situates capacity in pouring, filling or serving, and no item compares two vessels."
    },
    "competency_alignment": {
      "verdict": "CONCERN",
      "rationale": "The only axis that moves is the length of the numeral to be read, running from 3 up to 2893. That is digit-count growth, not growth in the measuring competence being certified."
    },
    "scale_appropriateness": {
      "verdict": "CONCERN",
      "rationale": "Capacities of 192 L and 285 L describe drums rather than the drinking glasses, bottles and pitchers a Grade 3 capacity lesson uses, so the sampled range sits above the competency's practical context."
    }
