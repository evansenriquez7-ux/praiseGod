  "findings": {
    "competency_fulfillment": {
      "verdict": "FAIL",
      "rationale": "No objects are compared; bare labelled numerals are. Worse, in most samples only one of the two quantities named in the stem is offered as an option. Asked Which is heavier: 19 g or 51 g?, the pupil chooses among 50, 53, 51 and 52, where 19 does not appear, so the answer is found by spotting the listed value rather than by comparing masses."
    },
    "comprehensive_coverage": {
      "verdict": "FAIL",
      "rationale": "The competency explicitly says including the use of a balance scale, and not one of the fifteen samples mentions, shows or reasons about a balance. The named instrument produces zero items."
    },
    "cognitive_capacity": {
      "verdict": "PASS",
      "rationale": "Deciding that 2593 exceeds 2351 is straightforward place-value comparison for Grade 3 Quarter 2, and the sentence form is a single short question with no extraneous load."
    },
    "variant_comprehensiveness": {
      "verdict": "FAIL",
      "rationale": "One interrogative frame governs all fifteen samples. There is no balance diagram, no named object, no ordering of three masses, no lighter-than direction, and no situation in which a comparison of mass would matter."
    },
    "competency_alignment": {
      "verdict": "CONCERN",
      "rationale": "Progression consists solely of longer numerals, from 4 against 6 up to 3200 against 4228. Comparing masses across different units, which is where this competency actually becomes demanding, never appears; every pair shares one unit."
    },
    "scale_appropriateness": {
      "verdict": "CONCERN",
      "rationale": "A 434 kg mass and a 4228 mg mass lie well outside the objects a Grade 3 pupil would place on a balance, and the widely separated pairs make the comparison trivial rather than instructive."
    }
  },
