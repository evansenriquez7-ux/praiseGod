  "findings": {
    "competency_fulfillment": {
      "verdict": "FAIL",
      "rationale": "Estimating a mass means judging how heavy something is without being told. Here the exact figure is supplied first, as in An object's mass measures 31 g, and the pupil merely rounds it. No object is ever identified either, so there is nothing whose mass could be estimated."
    },
    "comprehensive_coverage": {
      "verdict": "CONCERN",
      "rationale": "Grams, kilograms and milligrams all appear, but only one estimation move is ever generated, rounding to a power of ten. Judging a mass against a known benchmark, or choosing which unit is sensible for a given object, never occurs."
    },
    "cognitive_capacity": {
      "verdict": "CONCERN",
      "rationale": "One sample takes a 4 mg mass and rounds it to the nearest 10, keying the answer 0. Telling a Grade 3 pupil that an object's estimated mass is zero contradicts the physical premise the stem has just set up."
    },
    "variant_comprehensiveness": {
      "verdict": "FAIL",
      "rationale": "Thirteen items, one sentence. Measure, then round. The unit token and the rounding place are the entirety of the variation, and there is no applied setting, no comparison of two estimates, and no alternative item format beyond multiple choice and a cloze that reads identically."
    },
    "competency_alignment": {
      "verdict": "FAIL",
      "rationale": "The distractors are not possible answers. Against a key of 60 for a nearest-ten rounding, the options offered include 59, 61 and 62, none of which is a multiple of ten and none of which any rounding could produce. Every sample repeats this, so the option sets teach that rounding yields arbitrary nearby numbers."
    },
    "scale_appropriateness": {
      "verdict": "CONCERN",
      "rationale": "An estimate of 0 mg at one end and 307 kg at the other sit outside the masses a Grade 3 estimation task should involve, and rounding 1927 mg to the nearest 1000 concerns place value rather than any mass a pupil could picture."
    }
  },
  "overall": "FAIL"
}
