  "findings": {
    "competency_fulfillment": {
      "verdict": "FAIL",
      "rationale": "The estimate is handed over before it is requested. Each stem states the exact capacity and then asks only for a rounding, so the judgment the competency describes is never exercised; and since no vessel is ever identified, there is nothing whose capacity a pupil could estimate."
    },
    "comprehensive_coverage": {
      "verdict": "CONCERN",
      "rationale": "Litres and millilitres both appear, but rounding to a power of ten is the sole estimation operation generated. Choosing between candidate units for a given container, or benchmarking against a familiar one-litre bottle, is never produced."
    },
    "cognitive_capacity": {
      "verdict": "CONCERN",
      "rationale": "One sample sets the capacity at 3 L and keys the rounded answer as 0. A container that holds nothing is not an estimate a Grade 3 pupil can reconcile with the situation the stem has described."
    },
    "variant_comprehensiveness": {
      "verdict": "FAIL",
      "rationale": "Across thirteen samples nothing changes except the unit symbol and whether the rounding target is 10, 100 or 1000. No sample places the capacity in a situation, compares two estimates, or reverses the question."
    },
    "competency_alignment": {
      "verdict": "FAIL",
      "rationale": "The option sets cannot be answers to the question asked. For a nearest-ten rounding keyed at 60, the choices presented are 61, 62, 59 and 60, so three of four are not multiples of ten. The same pattern holds at the hundreds and thousands places, making the distractors impossible throughout."
    },
    "scale_appropriateness": {
      "verdict": "CONCERN",
      "rationale": "An estimated capacity of 0 L at the low end and 285 L at the high end both fall outside the containers this Grade 3 competency is about, so the sampled band brackets rather than matches its practical range."
    }
  },
  "overall": "FAIL"
}
