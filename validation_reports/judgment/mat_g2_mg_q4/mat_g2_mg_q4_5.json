    "comprehensive_coverage": {
      "verdict": "PASS",
      "rationale": "Triangles, squares and rectangles are all generated repeatedly, with squares given by a single side, rectangles given by two sides, and triangles given by three, so each figure's own perimeter rule gets exercised."
    },
    "cognitive_capacity": {
      "verdict": "PASS",
      "rationale": "The heaviest item asks for four times seventeen by repeated addition of a side, which is within the fourth-quarter range; all other cases are sums of small two-digit values."
    },
    "variant_comprehensiveness": {
      "verdict": "CONCERN",
      "rationale": "Apart from a single garden item asking how much fencing goes all the way around, every sample is the identical bare question about a figure's perimeter. No diagram-led, missing-side or comparison presentation occurs."
    },
    "competency_alignment": {
      "verdict": "CONCERN",
      "rationale": "Across all fourteen seeds the four options sit within three units of the key, so a pupil who forgets to double a rectangle's sides finds no option matching their error and simply guesses; the option set is tuned to near-misses rather than to the misconceptions this competency should surface."
    },
    "scale_appropriateness": {
