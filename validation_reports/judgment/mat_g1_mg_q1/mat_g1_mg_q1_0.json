  "findings": {
    "competency_fulfillment": {
      "verdict": "CONCERN",
      "rationale": "Most stems describe a figure by counting its edges and ask for the name, which tests the definition rather than identification of a shape actually seen at some size or turn. Only the read-format items and the sign that is 'turned upside down' put a figure in front of the pupil."
    },
    "comprehensive_coverage": {
      "verdict": "FAIL",
      "rationale": "The competency explicitly names different size and different orientation. Of eleven renders exactly one mentions a turn, and triangle is the key in six of them against two squares and two rectangles. The orientation sub-case is effectively unbuilt and the shape mix is lopsided."
    },
    "cognitive_capacity": {
      "verdict": "PASS",
      "rationale": "Stems are one sentence, the option list is four shape names, and edge counting is the intended Quarter 1 route into naming 2D shapes."
    },
    "variant_comprehensiveness": {
      "verdict": "CONCERN",
      "rationale": "Three stems recur word for word across different seeds - the party hat appears three times - and what changes between those renders is the ordering of the options rather than the shape, its size, or how it is presented."
    },
    "competency_alignment": {
      "verdict": "CONCERN",
      "rationale": "Nothing climbs toward the demanding half of the competency. No item requires recognising a rectangle standing on a corner or a square drawn unusually large, which is where identification stops being definition recall."
    },
    "scale_appropriateness": {
      "verdict": "PASS",
      "rationale": "Only the three named shapes plus a 'none of these' option ever appear; no circle, hexagon or solid from a later node is pulled in."
    }
  },
