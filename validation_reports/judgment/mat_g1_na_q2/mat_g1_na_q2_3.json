  "findings": {
    "competency_fulfillment": {
      "verdict": "CONCERN",
      "rationale": "Decomposition into tens and ones is what the keys record, but the worked example embedded in the stem, 'for example 45 = 40 + 5', collides with the seed 42 item whose target number is 45 -- that pupil is handed the answer verbatim before being asked for it."
    },
    "comprehensive_coverage": {
      "verdict": "PASS",
      "rationale": "The phrase 'any 2-digit number' is honoured across the range: teen numbers (12, 15), exact tens where the ones digit is zero (10, 20), and ordinary two-digit numbers (45, 76, 91, 94) all appear as targets."
    },
    "cognitive_capacity": {
      "verdict": "PASS",
      "rationale": "A single instruction plus a model equation is the whole reading load, and the base-10 block prompts give the concrete anchor a Quarter 2 Grade 1 pupil needs for this."
    },
    "variant_comprehensiveness": {
      "verdict": "CONCERN",
      "rationale": "Apart from the two block-building prompts, every stem is one sentence with the number swapped out; the reverse direction -- being given tens and ones and asked which number they make -- never appears, and neither does any contextual framing."
    },
    "competency_alignment": {
      "verdict": "PASS",
      "rationale": "Difficulty climbs on the one axis that matters here, from targets where the ones digit is 0 to targets like 76 and 94 where both parts must be produced, and the distractors shadow real errors such as reversing the digits."
    },
    "scale_appropriateness": {
      "verdict": "PASS",
      "rationale": "Targets run from 10 to 94, staying inside the two-digit band the competency specifies, and no decomposition requires a hundreds part."
    }
