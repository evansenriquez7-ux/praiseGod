  "findings": {
    "competency_fulfillment": {
      "verdict": "PASS",
      "rationale": "Stems do exactly what the competency names: each asks to round a stated number to a stated place, and the key is the rounded value. Seed 46 rounds 158 upward to 160 and seed 603 rounds 83 downward to 80, so both directions of the rounding decision are exercised."
    },
    "comprehensive_coverage": {
      "verdict": "PASS",
      "rationale": "All three named places appear as targets: nearest 10 (seed 42), nearest 100 (seed 45), nearest 1000 (seed 501 and 502). Rounding a number up across a thousands boundary is present too, since 6952 becomes 7000."
    },
    "cognitive_capacity": {
      "verdict": "CONCERN",
      "rationale": "The option sets repeatedly contain values that cannot be the answer to any rounding question. Seed 501 asks for the nearest 1000 yet offers 6010 and 6001, neither of which is a multiple of 1000, and a bare 0 appears as an option in roughly two thirds of the items. A pupil who only checks which option ends in the right number of zeros can answer without rounding anything, so the item demands far less than the competency intends."
    },
    "variant_comprehensiveness": {
      "verdict": "PASS",
      "rationale": "Besides the plain instruction form there is a number-line presentation, seen where the number 93 is described as marked on the number line, and the task appears under mcq, cloze and read_mcq. That is adequate presentational spread for a skill the curriculum states in purely numerical terms."
    },
    "competency_alignment": {
      "verdict": "PASS",
      "rationale": "What changes between easier and harder samples is the size of the number and the place being rounded to, moving from two-digit 38 up to four-digit 8438. That is the axis this competency is about, not an unrelated one."
    },
    "scale_appropriateness": {
      "verdict": "PASS",
      "rationale": "Numbers stay inside the four-digit territory a Grade 3 first-quarter pupil works in, topping out at 8438, and the thousands items only appear where a thousands target is requested."
    }
  },
  "overall": "CONCERN"
}
