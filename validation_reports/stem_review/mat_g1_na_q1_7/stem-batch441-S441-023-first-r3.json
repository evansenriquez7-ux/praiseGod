 "raw_reply": "{\"item\": \"S441-023\", \"clauses\": {\"illustrate\": {\"verdict\": \"PRODUCIBLE\", \"family\": \"F27\", \"template\": \"Show {a} + {b} on the number line.\", \"reasoning\": \"F27 asks the learner to show a sum on a number line, which is a pictorial model and an explicit illustration task. Its a and b are repeats of generated values with observed runs up to 18 and 8.\"}, \"addition_of_numbers\": {\"verdict\": \"PRODUCIBLE\", \"family\": \"F27\", \"template\": \"Show {a} + {b} on the number line.\", \"reasoning\": \"F27 prints the addition expression a + b as the object of the illustration task.\"}, \"sums_up_to_20\": {\"verdict\": \"PRODUCIBLE\", \"family\": \"F26\", \"template\": \"The two parts are {p1} and {p2}. What is the {word}?\", \"reasoning\": \"F26 gives two parts p1 and p2, which repeat generated values a and b, and asks for the sum. Declared bounds cap max_sum at 20, so the sums it produces are up to 20.\"}, \"concrete\": {\"verdict\": \"NOT_PRODUCIBLE\", \"family\": null, \"template\": null, \"reasoning\": \"Every object representation in the packet is an emoji string printed as text (F17 to F25), which is a pictorial display. No family presents manipulatives or physical counters.\"}, \"pictorial_models\": {\"verdict\": \"PRODUCIBLE\", \"family\": \"F14\", \"template\": \"{group_a_str} — There {v} {a} {name_a}.\", \"reasoning\": \"F14 shows groups of emoji pictures (nested F17 to F25) with a count, which is a pictorial model. The same clause is also produced by F27 on the number line, but F14 is the family that draws groups of objects.\"}, \"describes\": {\"verdict\": \"NOT_PRODUCIBLE\", \"family\": null, \"template\": null, \"reasoning\": \"No family asks the learner to describe addition in words. Every question family asks for a numeric answer, a count, or a number on a line.\"}, \"addition\": {\"verdict\": \"PRODUCIBLE\", \"family\": \"F27\", \"template\": \"Show {a} + {b} on the number line.\", \"reasoning\": \"F27 is a problem whose