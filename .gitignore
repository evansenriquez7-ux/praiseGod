.cache/
# `local_only/` is ignored EXCEPT the hardening loop's own protocol and audit trail.
# Git never descends into an excluded directory, so a bare `local_only/` makes every
# later `!local_only/scratch/...` negation dead text -- the exceptions must re-open each
# parent level first. Written out because the first version of this block looked correct
# and silently un-ignored nothing.
local_only/*
!local_only/scratch/
local_only/scratch/*
!local_only/scratch/hardening_ledger.md
!local_only/scratch/hardening_prompt.md
!local_only/scratch/gemini_hardening_loop_prompt.md
!local_only/scratch/ledger_archive/
#
# NOTE (2026-08-26): by CLAUDE.md's own file rules these do not belong under
# `local_only/scratch/`, which is for TEMPORARY files. The ledger is a permanent audit
# artifact (`validation_reports/`) and the prompts are operational protocol (`docs/`).
# Moving them is a workflow decision for the maintainer, not a correctness fix, so it is
# recorded here rather than done silently. `scripts/rotate_ledger.py` bounds the ledger.

# Logs
*.log

# Firebase
.firebase/
.firebaserc

# Graphify Local Artifacts
graphify-out/cache/
graphify-out/graph.html

# Practice-gen validation harness output: regenerated by every run_all /
# validate_matrix invocation (including single --node runs and the mutation
# harness), which overwrite it wholesale -- committing it meant any local run
# left the tree dirty and blocked plain git operations. CI already captures it
# via actions/upload-artifact on failure (deploy-backend.yml), so nothing
# depends on it being in git history.
validation_reports/matrix_report.json
# Per-node subset reports from `validate_matrix --node X`, added 2026-08-26 so a
# single-node run stops overwriting the tree-wide report. Derived output, same as
# the report above.
validation_reports/matrix_node_reports/
